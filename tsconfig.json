{
  // Type checking only -- this extension ships the JavaScript it is written in,
  // so tsc never emits. The types come from JSDoc; `npm run typecheck` is what
  // makes them mean something.
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "node16",
    "moduleResolution": "node16",
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    "noImplicitOverride": true,
    "noUncheckedIndexedAccess": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "types": ["node", "vscode"]
  },
  "include": ["extension.js", "src/**/*.js", "test/**/*.js", "eslint.config.js"],
  "exclude": ["node_modules", "dist"]
}
